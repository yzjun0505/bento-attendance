# 服务器端口
PORT=3000

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=user_information

# MongoDB 配置（可选）
MONGODB_URI=
MONGODB_DB=bento
MONGODB_REQUIRED=false

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Web 安全与限流
# 多个域名用英文逗号分隔；生产环境建议填写实际访问源，例如 https://example.com
ALLOWED_ORIGINS=
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=30
SOCKET_CONNECTION_LIMIT=20
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=1mb

# 高德地图 API Key
AMAP_KEY=your_amap_key_here

# AI 助手配置（DeepSeek，兼容 OpenAI 风格 /chat/completions；不配置时启用本地数据模式）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=1000000

# 腾讯云 IM 配置
TIM_SDK_APP_ID=1600142882
TIM_SECRET_KEY=your_tencent_im_secret_key_here
TIM_ADMIN_USERID=administrator
TIM_API_HOST=console.tim.qq.com
TIM_EXPIRE_TIME=604800

# App 更新配置
APP_ANDROID_VERSION_NAME=1.0.8
APP_ANDROID_VERSION_CODE=9
APP_ANDROID_MIN_VERSION_CODE=1
APP_ANDROID_FORCE_UPDATE=false
APP_ANDROID_DOWNLOAD_URL=http://150.158.79.174/uploads/releases/app-v1.0.8-9.apk
APP_ANDROID_RELEASE_NOTES=项目进度工作台升级：项目卡片、驾驶舱、阶段节点、进度上报与权限闭环
